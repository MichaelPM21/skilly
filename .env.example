# Skilly — configuración local
# Copiar a .env: Copy-Item .env.example .env
PORT=3000
ADMIN_PORT=3001
BASE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
HOST=127.0.0.1
NODE_ENV=development
COOKIE_SECURE=false
TRUST_PROXY=false
# PostgreSQL: usuario propio para Skilly; nunca usar postgres en la aplicación.
DATABASE_URL=postgresql://skilly_app:CAMBIAR@127.0.0.1:5432/skilly
# Pruebas aisladas; el nombre debe terminar en _test.
TEST_DATABASE_URL=postgresql://skilly_app:CAMBIAR@127.0.0.1:5432/skilly_test
# Opcional: carpeta de pg_dump y pg_restore si no están en PATH.
PG_BIN=

# Cuentas administrativas: ejecutar npm run admin:create.
# Ya no se utiliza ADMIN_PASSCODE ni una clave compartida.

# Correo Gmail (opcional para pruebas locales)
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=

# Webpay Plus: mantener integration para esta versión de pruebas.
WEBPAY_ENV=integration
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=

# PayPal: cuentas y credenciales sandbox de tu aplicación.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CLP_USD_RATE=950
