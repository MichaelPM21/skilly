# Skilly — configuración local
# Copiar a .env: Copy-Item .env.example .env
PORT=3000
ADMIN_PORT=3001
BASE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
HOST=127.0.0.1
NODE_ENV=development
COOKIE_SECURE=false
TRUST_PROXY=false
# Ruta opcional compartida por ambas aplicaciones. Vacío: server/skilly.db
DB_PATH=
# Solo para una base nueva: incluye los perfiles de ejemplo anteriores.
SEED_DEMO=true

# Cuentas administrativas: ejecutar npm run admin:create.
# Ya no se utiliza ADMIN_PASSCODE ni una clave compartida.

# Correo Gmail (opcional para pruebas locales)
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=

# Webpay Plus: mantener integration para esta versión de pruebas.
WEBPAY_ENV=integration
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=

# PayPal: cuentas y credenciales sandbox de tu aplicación.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CLP_USD_RATE=950
